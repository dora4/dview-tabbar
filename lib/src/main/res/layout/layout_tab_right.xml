<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/ll_tab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_tab_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_tab_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

    </LinearLayout>

    <dora.widget.badge.BadgeView
        android:id="@+id/bv_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/ll_tab"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:dview_bv_backgroundColor="@color/dview_tabbar_badge_red"
        app:dview_bv_isRadiusHalfHeight="true"
        app:dview_bv_strokeColor="#FFFFFF"
        app:dview_bv_strokeWidth="1dp"/>

</RelativeLayout>